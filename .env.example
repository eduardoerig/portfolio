# Banco. Local: arquivo SQLite (relativo à pasta prisma/). Produção: URL libsql:// do banco remoto + token.
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=

# Só para publicar a primeira vez (npm run db:remote:init e npm run db:copy), no .env local.
REMOTE_DATABASE_URL=
REMOTE_DATABASE_AUTH_TOKEN=

# Hash bcrypt da senha do painel (/admin). Gere com:
#   npm run hash-password -- minha-senha
# O comando já imprime a linha pronta. O Next trata "$" como variável, então cada
# "$" precisa de barra e SEM aspas (aspas não resolvem): ADMIN_PASSWORD_HASH=\$2b\$12\$...
# Vazio = ninguém consegue entrar.
ADMIN_PASSWORD_HASH=

# Segredo que assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Bucket R2 (API compatível com S3) para foto, imagens e currículo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket, sem barra no fim (ex.: https://pub-xxxx.r2.dev ou https://arquivos.seudominio.com).
NEXT_PUBLIC_FILES_URL=

# Endereço público do site (links absolutos e metadados). Vazio = http://localhost:3000.
SITE_URL=
